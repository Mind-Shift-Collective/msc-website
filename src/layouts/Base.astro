---
import '../styles/global.css';
interface Props { title: string; description?: string; current?: string; }
const { title, description = 'Mind Shift Collective is a referral-based community of practice for the people building the future of mental health and psychedelic medicine.', current = '' } = Astro.props;
const nav = [
  { href: '/directory', label: 'Directory' },
  { href: '/builder-series', label: 'Builder Series' },
  { href: '/presenter-series', label: 'Presenter Series' },
  { href: '/events', label: 'Events' },
  { href: '/advisory', label: 'Work with experts' },
];
const fullTitle = title === 'Home' ? 'Mind Shift Collective' : `${title} · Mind Shift Collective`;
const isPreview = import.meta.env.PUBLIC_SITE_LIVE !== 'true';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {isPreview && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Inter:wght@400;500;600&display=swap" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <slot name="head" />
  <script is:inline>
    // Soft launch: on the real domain only the join form is live, so hide links to the rest of the site.
    if (/(^|\.)mindshiftcollective\.net$/.test(location.hostname)) document.documentElement.classList.add('soft-launch');
  </script>
  <style is:global>
    .soft-launch [data-site-only] { display: none !important; }
  </style>
</head>
<body>
  <a href="#main" class="skip" style="position:absolute;left:-999px;top:0;background:#fff;padding:8px 12px;z-index:10" onfocus="this.style.left='8px'" onblur="this.style.left='-999px'">Skip to content</a>
  <header style="border-bottom:1px solid var(--gold);">
    <div class="wrap row" style="justify-content:space-between;padding-top:18px;padding-bottom:18px;">
      <a href="/" style="text-decoration:none;color:var(--ink);display:flex;align-items:center;gap:12px;">
        <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="16" fill="none" stroke="#2E5E4E" stroke-width="2"></circle><path d="M6 22 C12 12, 18 12, 18 18 S24 24, 30 14" fill="none" stroke="#C9A227" stroke-width="2"></path></svg>
        <span style="font-family:var(--serif);font-size:22px;font-weight:500;">Mind Shift Collective</span>
      </a>
      <nav aria-label="Main" data-site-only class="row" style="gap:22px;font-size:15px;">
        {nav.map((n) => (
          <a href={n.href} aria-current={current === n.href ? 'page' : undefined} style={`text-decoration:none;color:${current === n.href ? 'var(--forest)' : 'var(--ink)'};font-weight:${current === n.href ? 600 : 400}`}>{n.label}</a>
        ))}
        <a href="/join" class="btn" style="min-height:44px;padding:10px 20px;font-size:15px;">Request to join</a>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer style="border-top:1px solid var(--gold);">
    <div class="wrap row" style="justify-content:space-between;padding-top:40px;padding-bottom:40px;font-size:14px;color:var(--muted);">
      <span style="display:flex;align-items:center;gap:8px;">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 L14 10 L22 12 L14 14 L12 22 L10 14 L2 12 L10 10 Z" fill="#C9A227"></path></svg>
        Rooted in relationship. <a href="https://northstar.guide/ethicspledge">North Star Ethics Pledge</a> signatory.
      </span>
      <span class="row" style="gap:18px;">
        <a data-site-only href="/companies">Companies</a>
        <a data-site-only href="/partners">Partners</a>
        <a data-site-only href="/archive">Events archive</a>
        <a data-site-only href="/#stay-close">Newsletter</a>
        <a href="/privacy">Privacy</a>
        <a data-site-only href="https://www.youtube.com/@mindshifthealth">YouTube</a>
        <a href="mailto:hello@mindshiftcollective.net">hello@mindshiftcollective.net</a>
      </span>
    </div>
  </footer>
</body>
</html>
