---
import '../styles/global.css';
interface Props { title: string; description?: string; current?: string; index?: boolean; canonical?: string; }
const { title, description = 'Mind Shift Collective is a referral-based community of practice for the people building the future of mental health and psychedelic medicine.', current = '', index = false, canonical } = Astro.props;
const nav = [
  { href: '/directory', label: 'Directory' },
  { href: '/builder-series', label: 'Builder Series' },
  { href: '/presenter-series', label: 'Presenter Series' },
  { href: '/events', label: 'Events' },
  { href: '/advisory', label: 'Work with experts' },
];
const fullTitle = title === 'Home' ? 'Mind Shift Collective' : `${title} · Mind Shift Collective`;
const isPreview = import.meta.env.PUBLIC_SITE_LIVE !== 'true';
// Join-only mode: hide the menu and links to the rest of the site everywhere. Set to false to show the full site.
const JOIN_ONLY = true;
---
<!doctype html>
<html lang="en" class={JOIN_ONLY ? 'soft-launch' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {/* Only pages that opt in with index={true} can be indexed, and only on the real domain (robots-preview.txt blocks netlify.app). */}
  {(isPreview && !index) && <meta name="robots" content="noindex, nofollow" />}
  {canonical && <link rel="canonical" href={canonical} />}
  {canonical && <meta property="og:url" content={canonical} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300;400;500;600&family=DM+Sans:wght@400;500;600&display=swap" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <slot name="head" />
  <script is:inline>
    // Soft launch: on the real domain only the join form is live, so hide links to the rest of the site.
    if (/(^|\.)mindshiftcollective\.net$/.test(location.hostname)) document.documentElement.classList.add('soft-launch');
  </script>
  <style is:global>
    .soft-launch [data-site-only] { display: none !important; }
  </style>
</head>
<body>
  <a href="#main" class="skip" style="position:absolute;left:-999px;top:0;background:#fff;padding:8px 12px;z-index:10" onfocus="this.style.left='8px'" onblur="this.style.left='-999px'">Skip to content</a>
  <header style="border-bottom:1px solid var(--gold);background:var(--ground);">
    <div class="wrap row" style="justify-content:space-between;padding-top:18px;padding-bottom:18px;">
      <a href={JOIN_ONLY ? '/join' : '/'} style="text-decoration:none;color:var(--ink);display:flex;align-items:center;gap:12px;">
        <img src="/brand/msc-logo.png" alt="Mind Shift Collective" height="40" style="height:40px;width:auto;display:block;" />
              </a>
      <nav aria-label="Main" data-site-only class="row" style="gap:22px;font-size:15px;">
        {nav.map((n) => (
          <a href={n.href} aria-current={current === n.href ? 'page' : undefined} style={`text-decoration:none;color:${current === n.href ? 'var(--forest)' : 'var(--ink)'};font-weight:${current === n.href ? 600 : 400}`}>{n.label}</a>
        ))}
        <a href="/join" class="btn" style="min-height:44px;padding:10px 20px;font-size:15px;">Request to join</a>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer style="border-top:1px solid var(--gold);">
    <!-- Email signup on every page. Same Netlify "newsletter" form as the home page, so signups sync to MSC Kit. -->
    <div class="wrap row" style="justify-content:space-between;align-items:center;gap:16px 32px;padding-top:36px;padding-bottom:28px;border-bottom:1px solid var(--line);">
      <div style="max-width:460px;">
        <p style="margin:0;font-family:var(--serif);font-size:24px;color:var(--ink);">Stay in the loop.</p>
        <p style="margin:4px 0 0;font-size:14px;color:var(--muted);">Occasional updates on gatherings, community news and the field. One click to unsubscribe. We never share your email.</p>
      </div>
      <form name="newsletter" method="POST" action="/thank-you?f=newsletter" data-netlify="true" netlify-honeypot="company_website" class="row" style="gap:10px;align-items:flex-end;flex:1 1 380px;max-width:560px;">
        <input type="hidden" name="form-name" value="newsletter" />
        <input type="hidden" name="subject" value="[MSC Newsletter] New subscriber" />
        <input type="hidden" name="topics[]" value="Newsletter" />
        <p class="hidden"><label>Leave this empty <input name="company_website" /></label></p>
        <div class="field" style="flex:1 1 130px;margin:0;"><label for="ft-name">First name</label><input id="ft-name" name="first_name" type="text" autocomplete="given-name" /></div>
        <div class="field" style="flex:2 1 200px;margin:0;"><label for="ft-email">Email</label><input id="ft-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" /></div>
        <button class="btn" type="submit">Subscribe</button>
      </form>
    </div>
    <div class="wrap row contribute" style="justify-content:space-between;align-items:center;gap:16px 32px;padding-top:36px;padding-bottom:28px;border-bottom:1px solid var(--line);">
      <div style="max-width:560px;">
        <p style="margin:0;font-family:var(--serif);font-size:24px;color:var(--ink);">Help keep this community going.</p>
        <p style="margin:4px 0 0;font-size:14px;color:var(--muted);">Mind Shift Collective is community-run. Contributions of any amount support the Slack, Builder Series, Community Calls and directory.</p>
      </div>
      <a class="btn" href="https://buy.stripe.com/14A4gBgvK0fB2I9d9T8N201" target="_blank" rel="noopener">Contribute</a>
    </div>
    <div class="wrap row" style="justify-content:space-between;padding-top:28px;padding-bottom:40px;font-size:14px;color:var(--muted);">
      <span style="display:flex;align-items:center;gap:8px;">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 L14 10 L22 12 L14 14 L12 22 L10 14 L2 12 L10 10 Z" fill="#FF4930"></path></svg>
        Rooted in relationship. <a href="https://northstar.guide/ethicspledge">North Star Ethics Pledge</a> signatory.
      </span>
      <span class="row" style="gap:18px;">
        <a data-site-only href="/companies">Companies</a>
        <a data-site-only href="/partners">Partners</a>
        <a data-site-only href="/archive">Events archive</a>
        <a data-site-only href="/#stay-close">Newsletter</a>
        <a href="/privacy">Privacy</a>
        <a href="https://www.linkedin.com/company/mind-shift-collective/" target="_blank" rel="noopener">LinkedIn</a>
        <a data-site-only href="https://www.youtube.com/@mindshifthealth">YouTube</a>
        <a href="mailto:hello@mindshiftcollective.net">hello@mindshiftcollective.net</a>
      </span>
    </div>
  </footer>
</body>
</html>
