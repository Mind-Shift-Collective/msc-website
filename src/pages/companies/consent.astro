---
import Base from '../../layouts/Base.astro';
const show = [
  ['Company name', 'name'],
  ['Logo', 'logo'],
  ['Website link', 'website'],
  ['One-sentence description', 'description'],
  ['A link from the company to my member card', 'member-link'],
];
---
<Base title="Company Listing Consent" current="/companies" description="Give Mind Shift Collective written consent to list your organization on our site.">
  <section style="padding-top:72px;padding-bottom:88px;">
    <div class="wrap row" style="gap:56px;align-items:flex-start;">
      <div class="stack" style="flex:1 1 320px;min-width:0;gap:16px;">
        <p class="eyebrow" style="margin:0;">Company Listing Consent</p>
        <h1 style="font-size:clamp(34px,4.5vw,46px);">List your organization</h1>
        <p style="color:var(--ink-2);">We list organizations on our Companies Represented page only with written consent from someone authorized to act for them. Please read the terms, choose what we may show, and sign.</p>
        <div class="panel stack" style="gap:10px;font-size:15px;">
          <h2 style="font-size:20px;margin:0;">Terms</h2>
          <ol style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px;color:var(--ink-2);">
            <li><strong>Permission.</strong> You allow Mind Shift Health, Inc., which operates Mind Shift Collective ("MSC"), to show the items you select below on mindshiftcollective.net, including the Companies Represented page and member cards.</li>
            <li><strong>Authority.</strong> You confirm you are authorized to grant this permission for the organization named.</li>
            <li><strong>No endorsement.</strong> A listing means a member works with or at the organization. It is not an endorsement by MSC or by the organization, and it does not make the organization a partner or sponsor.</li>
            <li><strong>Marks.</strong> You grant MSC a non-exclusive, royalty-free, revocable license to display the organization's name and logo for this listing only. The organization keeps all rights to its marks. MSC will not alter the logo except to resize it.</li>
            <li><strong>Accuracy.</strong> You will tell us if anything changes. We may edit descriptions for length and clarity and will check major changes with you.</li>
            <li><strong>Withdrawal.</strong> You can withdraw consent at any time by emailing hello@mindshiftcollective.net. We will remove the listing within 10 business days.</li>
            <li><strong>Privacy.</strong> Your information is handled under our <a href="/privacy">Privacy, Use, and Disposal Statement</a>. We keep a record of this consent while the listing is live and for two years after it is removed.</li>
          </ol>
        </div>
      </div>

      <form class="panel" style="flex:999 1 520px;min-width:0;" name="company-consent" method="POST" action="/thank-you?f=consent" data-netlify="true" netlify-honeypot="company_website" enctype="multipart/form-data">
        <input type="hidden" name="form-name" value="company-consent" />
        <input type="hidden" name="subject" value="[MSC Consent] Company listing consent" />
        <input type="hidden" name="Terms version" value="2026-11-15" />
        <p class="hidden"><label>Leave this empty <input name="company_website" /></label></p>

        <h2 style="font-size:20px;margin:0;">The organization</h2>
        <div class="field"><label for="c-org">Organization legal name</label><input id="c-org" name="Organization" type="text" required /></div>
        <div class="field"><label for="c-display">Name to display (if different)</label><input id="c-display" name="Display name" type="text" /></div>
        <div class="field"><label for="c-site">Website</label><input id="c-site" name="Website" type="url" placeholder="https://" /></div>
        <div class="field"><label for="c-desc">One-sentence description</label><input id="c-desc" name="Description" type="text" maxlength="180" /></div>
        <div class="field"><label for="c-logo">Logo (SVG or PNG, optional)</label><input id="c-logo" name="Logo" type="file" accept=".svg,.png,image/svg+xml,image/png" /></div>

        <fieldset>
          <legend>What may we show? (Select all that apply)</legend>
          {show.map(([label, v]) => <label class="check"><input type="checkbox" name="May show[]" value={label} checked={v === 'name'} /> {label}</label>)}
        </fieldset>

        <h2 style="font-size:20px;margin:8px 0 0;">You</h2>
        <div class="row" style="gap:16px;align-items:flex-start;">
          <div class="field"><label for="c-name">Full name</label><input id="c-name" name="Signer name" type="text" required autocomplete="name" /></div>
          <div class="field"><label for="c-title">Title or role</label><input id="c-title" name="Signer title" type="text" required autocomplete="organization-title" /></div>
        </div>
        <div class="field"><label for="c-email">Work email</label><input id="c-email" name="Signer email" type="email" required autocomplete="email" /></div>
        <div class="field"><label for="c-member">MSC member connected to this organization (if not you)</label><input id="c-member" name="Connected member" type="text" /></div>

        <div class="stack" style="gap:8px;border-top:1px solid #EDE8DD;padding-top:16px;">
          <label class="check"><input type="checkbox" name="Authorized" value="yes" required /> I am authorized to grant this permission for the organization named above.</label>
          <label class="check"><input type="checkbox" name="Agrees to terms" value="yes" required /> I have read and agree to the Company Listing Consent terms.</label>
          <div class="field"><label for="c-sig">Type your full name as your signature</label><input id="c-sig" name="Signature" type="text" required /></div>
          <div class="field"><label for="c-date">Date</label><input id="c-date" name="Date signed" type="date" required /></div>
        </div>
        <button class="btn" type="submit" style="align-self:flex-start;">Sign and submit</button>
      </form>
    </div>
  </section>
</Base>
