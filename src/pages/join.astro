---
import Base from '../layouts/Base.astro';

// Questions and options mirror the original Notion intake form
// ("Request an Invite: Mind Shift Collective") so new answers line up with past ones.
const engagement = ['Actively or recently engaged', 'Interested in getting started'];
const heard = ['Friend / Colleague', 'Social media / LinkedIn', 'Event / Conference', 'Other'];
const capacities = [
  'Founder / co-founder',
  'Consultant / solopreneur',
  'Researcher',
  'Medical professional / clinician',
  'Licensed Therapist',
  'Pharmaceutical industry',
  'Investor (for-profit focus)',
  'Philanthropic Executive / Funder (non-profit focus)',
  'Government / policy / lawyer / legal support',
  'Professional educator or learning designer',
  'Journalist / media',
  'Indigenous / cultural leader',
  'Student (pursuing a career in psychedelics)',
  'Other',
];
const privacyUrl = '/privacy';
---
<Base title="Request an invite" current="/join" description="Mind Shift Collective grows by referral. Request an invite to join the community.">
  <section style="padding-top:64px;">
    <div class="wrap row" style="gap:56px;align-items:flex-start;">
      <div class="stack" style="flex:1 1 300px;min-width:0;gap:18px;">
        <p class="eyebrow" style="margin:0;">Request an invite</p>
        <h1 style="font-size:clamp(38px,5vw,48px);">Come in through someone you trust</h1>
        <p style="color:var(--ink-2);">Mind Shift Collective is a referral-based community of builders in mental health and psychedelic medicine. Tell us about yourself and who referred you. Every request is reviewed by a person.</p>
        <ol style="margin:8px 0 0;padding-left:20px;color:var(--ink-2);display:flex;flex-direction:column;gap:10px;">
          <li>You send this request.</li>
          <li>We confirm with your sponsor, if you have one.</li>
          <li>We review it and, if it's a fit, send your welcome and Slack invite.</li>
        </ol>
      </div>

      <form class="panel" style="flex:999 1 560px;min-width:0;" name="join-request" method="POST" action="/thank-you?f=join" data-netlify="true" netlify-honeypot="company_website">
        <input type="hidden" name="form-name" value="join-request" />
        <input type="hidden" name="subject" value="[MSC Join] New invite request" />
        <p class="hidden"><label>Leave this empty <input name="company_website" /></label></p>

        <div class="row" style="gap:16px;align-items:flex-start;">
          <div class="field"><label for="j-first">First Name</label><input id="j-first" name="First Name" type="text" required autocomplete="given-name" /></div>
          <div class="field"><label for="j-last">Last Name</label><input id="j-last" name="Last Name" type="text" required autocomplete="family-name" /></div>
        </div>
        <div class="field"><label for="j-email">Email</label><input id="j-email" name="Email" type="email" required autocomplete="email" /></div>

        <fieldset>
          <legend>Are you actively or recently engaged in building the psychedelics ecosystem, or interested in getting started?</legend>
          {engagement.map((o) => <label class="check"><input type="checkbox" name="Engagement" value={o} /> {o}</label>)}
        </fieldset>

        <div class="field"><label for="j-city">Closest major city (list all, if in multiple cities)</label><input id="j-city" name="Closest major city" type="text" /></div>

        <div class="row" style="gap:16px;align-items:flex-start;">
          <div class="field"><label for="j-org">Company / Organization Name (current or most recent)</label><input id="j-org" name="Company / Organization" type="text" autocomplete="organization" /></div>
          <div class="field"><label for="j-title">Job Title (current or most recent)</label><input id="j-title" name="Job Title" type="text" autocomplete="organization-title" /></div>
        </div>
        <div class="field"><label for="j-orgdesc">One sentence description of that company / organization</label><input id="j-orgdesc" name="Organization description" type="text" /></div>
        <div class="field"><label for="j-li">LinkedIn Profile</label><input id="j-li" name="LinkedIn Profile" type="url" placeholder="https://www.linkedin.com/in/..." /></div>

        <fieldset>
          <legend>In which of the following capacities have you worked (professionally, within the past five years)?</legend>
          <div class="pills">
            {capacities.map((c) => <label><input type="checkbox" name="Capacities" value={c} /><span>{c}</span></label>)}
          </div>
        </fieldset>
        <div class="field"><label for="j-other">If Other please describe your engagement in the field:</label><textarea id="j-other" name="Other engagement" rows="3"></textarea></div>

        <div class="stack" style="background:var(--ground);border:1px solid var(--line);border-radius:14px;padding:22px;gap:14px;">
          <div class="field"><label for="j-sponsor">Please name a current member who is your sponsor/referral</label><input id="j-sponsor" name="Sponsor" type="text" /></div>
          <div class="field"><label for="j-sponsor-email">Your sponsor's email (optional, helps us confirm quickly)</label><input id="j-sponsor-email" name="Sponsor email" type="email" /></div>
          <div class="field"><label for="j-nosponsor">If you do not have a sponsor/referral, please tell us about your interest in the Collective?</label><textarea id="j-nosponsor" name="Interest without sponsor" rows="4"></textarea></div>
        </div>

        <fieldset>
          <legend>How did you first hear about Mind Shift Collective?</legend>
          {heard.map((o) => <label class="check"><input type="checkbox" name="How heard" value={o} /> {o}</label>)}
        </fieldset>

        <div class="field"><label for="j-ask">What is one thing you'd like to ask from the community?</label><textarea id="j-ask" name="Ask from community" rows="3"></textarea></div>
        <div class="field"><label for="j-offer">What is one thing you'd like to offer to community?</label><textarea id="j-offer" name="Offer to community" rows="3"></textarea></div>

        <div class="stack" style="gap:6px;border-top:1px solid #EDE8DD;padding-top:16px;">
          <label class="check"><input type="checkbox" name="Directory" value="yes" /> I would be interested in learning about or being added to a MindShift Collective directory.</label>
          <label class="check"><input type="checkbox" name="Privacy agreement" value="I agree" required /> <span>I agree to the <a href={privacyUrl} target="_blank" rel="noopener">Privacy, Use, and Disposal Statement</a>.</span></label>
        </div>

        <button class="btn" type="submit" style="align-self:flex-start;">Request an invite</button>
      </form>
    </div>
  </section>
</Base>
