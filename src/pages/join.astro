---
import Base from '../layouts/Base.astro';

// Questions and options mirror the original Notion intake form
// ("Request an Invite: Mind Shift Collective") so new answers line up with past ones.
const engagement = ['Actively or recently engaged', 'Interested in getting started'];
const heard = ['Friend / Colleague', 'Social media / LinkedIn', 'Event / Conference', 'Other'];
const capacities = [
  'Founder / co-founder',
  'Consultant / solopreneur',
  'Researcher',
  'Medical professional / clinician',
  'Licensed Therapist',
  'Pharmaceutical industry',
  'Investor (for-profit focus)',
  'Philanthropic Executive / Funder (non-profit focus)',
  'Government / policy / lawyer / legal support',
  'Professional educator or learning designer',
  'Journalist / media',
  'Indigenous / cultural leader',
  'Student (pursuing a career in psychedelics)',
  'Other',
];
const privacyUrl = '/privacy';
const chathamUrl = 'https://docs.google.com/document/d/13mwQXoi_2c64-La304dbyoxoYKRzfFhaqMOOxhq6mAo/edit?tab=t.0';
---
<Base title="Request an invite" current="/join" description="Mind Shift Collective grows by referral. Request an invite to join the community.">
  <section style="padding-top:40px;padding-bottom:56px;">
    <div class="wrap row" style="gap:40px;align-items:flex-start;">
      <div class="stack" style="flex:1 1 300px;min-width:0;gap:12px;font-size:15px;">
        <p class="eyebrow" style="margin:0;">Request an invite</p>
        <h1 style="font-size:clamp(38px,5vw,48px);">Request an Invite: Mind Shift Collective</h1>
        <p style="color:var(--ink-2);">The Mind Shift Collective is a global Slack community where builders of the psychedelic ecosystem connect to amplify one another's impact. By pooling our diverse talents (researchers, founders, educators, investors, clinicians and more) we turn small, strategic actions into outsized, positive change for humanity through meaningful conversation and collaboration.</p>
        <p style="color:var(--ink-2);">We are in the early days of this experiment, so we are growing slowly, with intention. We are seeking those ready to engage and participate fully. If that is you, please fill out this form to receive your invitation to this free Slack community.</p>
        <p style="color:var(--ink-2);">All members agree to abide by the Chatham House Rule in regards to confidentiality around interactions and conversations within our Slack community and our live online events. For more information please review <a href={chathamUrl} target="_blank" rel="noopener">this document</a>.</p>
        <p style="color:var(--ink-2);">Your data is for internal purposes only and will not be used, unless with explicit consent.</p>
        <p style="margin:0;">Your MindShift Harbingers,<br /><strong>Nick Nowak, Renée Franzwa, David Drapkin</strong></p>
      </div>

      <form class="panel compact" style="flex:999 1 560px;min-width:0;" name="join-request" method="POST" action="/thank-you?f=join" data-netlify="true" netlify-honeypot="company_website">
        <input type="hidden" name="form-name" value="join-request" />
        <input type="hidden" name="subject" value="[MSC Join] New invite request" />
        <p class="hidden"><label>Leave this empty <input name="company_website" /></label></p>

        <div class="row" style="gap:16px;align-items:flex-start;">
          <div class="field"><label for="j-first">First Name</label><input id="j-first" name="First Name" type="text" required autocomplete="given-name" /></div>
          <div class="field"><label for="j-last">Last Name</label><input id="j-last" name="Last Name" type="text" required autocomplete="family-name" /></div>
        </div>
        <div class="field"><label for="j-email">Email</label><input id="j-email" name="Email" type="email" required autocomplete="email" /></div>

        <fieldset>
          <legend>Are you actively or recently engaged in building the psychedelics ecosystem, or interested in getting started? <small>(Select as many as you like)</small></legend>
          {engagement.map((o) => <label class="check"><input type="checkbox" name="Engagement[]" value={o} /> {o}</label>)}
        </fieldset>

        <div class="field"><label for="j-city">Closest major city (list all, if in multiple cities)</label><input id="j-city" name="Closest major city" type="text" /></div>

        <div class="row" style="gap:16px;align-items:flex-start;">
          <div class="field"><label for="j-org">Company / Organization Name (current or most recent)</label><input id="j-org" name="Company / Organization" type="text" autocomplete="organization" /></div>
          <div class="field"><label for="j-title">Job Title (current or most recent)</label><input id="j-title" name="Job Title" type="text" autocomplete="organization-title" /></div>
        </div>
        <div class="field"><label for="j-orgdesc">One sentence description of that company / organization</label><input id="j-orgdesc" name="Organization description" type="text" /></div>
        <div class="field"><label for="j-li">LinkedIn Profile</label><input id="j-li" name="LinkedIn Profile" type="url" placeholder="https://www.linkedin.com/in/..." /></div>

        <fieldset>
          <legend>In which of the following capacities have you worked (professionally, within the past five years)? <small>(Select as many as you like)</small></legend>
          <div class="pills">
            {capacities.map((c) => <label><input type="checkbox" name="Capacities[]" value={c} /><span>{c}</span></label>)}
          </div>
        </fieldset>
        <div class="field"><label for="j-other">If Other please describe your engagement in the field:</label><textarea id="j-other" name="Other engagement" rows="2"></textarea></div>

        <div class="stack" style="background:var(--ground);border:1px solid var(--line);border-radius:12px;padding:16px;gap:10px;">
          <div class="field"><label for="j-sponsor">Please name a current member who is your sponsor/referral</label><input id="j-sponsor" name="Sponsor" type="text" /></div>
          <div class="field"><label for="j-sponsor-email">Your sponsor's email (optional, helps us confirm quickly)</label><input id="j-sponsor-email" name="Sponsor email" type="email" /></div>
          <div class="field"><label for="j-nosponsor">If you do not have a sponsor/referral, please tell us about your interest in the Collective?</label><textarea id="j-nosponsor" name="Interest without sponsor" rows="2"></textarea></div>
        </div>

        <fieldset>
          <legend>How did you first hear about Mind Shift Collective? <small>(Select as many as you like)</small></legend>
          {heard.map((o) => <label class="check"><input type="checkbox" name="How heard[]" value={o} /> {o}</label>)}
        </fieldset>

        <div class="field"><label for="j-ask">What is one thing you'd like to ask from the community?</label><small style="color:var(--ink-2);">Examples: I am looking for a collaborator on a project; Help me understand where we are at with Ibogaine.</small><textarea id="j-ask" name="Ask from community" rows="2"></textarea></div>
        <div class="field"><label for="j-offer">What is one thing you'd like to offer to community?</label><small style="color:var(--ink-2);">Examples: I love mentoring folks earlier in their career; I'm researching end of life care and have research/insights to share.</small><textarea id="j-offer" name="Offer to community" rows="2"></textarea></div>

        <div class="stack" style="gap:6px;border-top:1px solid #EDE8DD;padding-top:10px;">
          <label class="check"><input type="checkbox" name="Directory" value="yes" /> <span>I would be interested in learning about or being added to a MindShift Collective directory.<br /><small style="color:var(--ink-2);">Nothing is listed publicly without your explicit consent.</small></span></label>
          <label class="check"><input type="checkbox" name="Privacy agreement" value="I agree" required /> <span>I agree to the <a href={privacyUrl} target="_blank" rel="noopener">Privacy, Use, and Disposal Statement</a>.</span></label>
        </div>

        <button class="btn" type="submit" style="align-self:flex-start;">Request an invite</button>
      </form>
    </div>
  </section>
</Base>
