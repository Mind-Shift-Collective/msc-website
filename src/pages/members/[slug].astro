---
import Base from '../../layouts/Base.astro';
import members from '../../data/members.json';

export function getStaticPaths() {
  return members.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const roleLabels = m.roles.map((r) => (r === 'Other' ? m.otherRole : r));
const company = m.companies[0];
const ytId = (url) => {
  if (!url) return '';
  const match = url.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
  return match ? match[1] : '';
};
const video = ytId(m.youtube);
const sameAs = [m.website, m.linkedin].filter(Boolean);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: m.name,
  description: m.headline,
  ...(sameAs.length ? { sameAs } : {}),
  ...(company ? { worksFor: { '@type': 'Organization', name: company.name, ...(company.website ? { url: company.website } : {}) } } : {}),
  memberOf: { '@type': 'Organization', name: 'Mind Shift Collective', url: 'https://www.mindshiftcollective.net' },
};
---
<Base title={m.name} current="/directory" description={`${m.name}: ${m.headline} Member of Mind Shift Collective.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  {m.sample && <div class="notice">Preview: this is a sample member card.</div>}
  {m.draft && <div class="notice">Draft card: waiting for approval. Bracketed text still needs filling in.</div>}
  <section style="padding-top:56px;">
    <div class="wrap row" style="gap:56px;align-items:flex-start;">
      <div class="stack-lg" style="flex:999 1 560px;min-width:0;">
        <a href="/directory" style="font-weight:500;font-size:15px;">Back to the directory</a>
        <div class="row" style="gap:28px;">
          <div class="avatar lg" aria-hidden="true">{m.initials}</div>
          <div class="stack" style="gap:10px;min-width:0;">
            <h1 style="font-size:clamp(38px,5vw,52px);">{m.name}</h1>
            <p style="font-size:19px;color:var(--ink-2);">{roleLabels[0]}{company ? `, ${company.name}` : ''} · {m.city}</p>
            <div class="row" style="gap:6px;">
              {roleLabels.map((r) => <span class="chip solid">{r}</span>)}
              {m.focus.map((f) => <span class="chip">{f}</span>)}
            </div>
          </div>
        </div>

        <div class="stack" style="gap:12px;">
          <h2 style="font-size:28px;font-weight:500;">About</h2>
          <p style="font-size:18px;line-height:1.7;color:var(--ink-2);">{m.bio}</p>
        </div>

        {company && (
          <div class="card" style="padding:0;overflow:hidden;gap:0;">
            {video
              ? <iframe class="video" style="border-radius:0;" src={`https://www.youtube-nocookie.com/embed/${video}?rel=0`} title={`${company.name} video`} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              : null}
            <div class="row" style="padding:26px;gap:18px;">
              <div style="flex:1 1 260px;min-width:0;">
                <h3 style="font-family:var(--sans);font-size:20px;font-weight:600;">{company.name}</h3>
                <p style="font-size:15px;color:var(--ink-2);">{company.line}</p>
              </div>
              {company.website && <a class="btn ghost" href={company.website}>Visit website</a>}
            </div>
          </div>
        )}

        <div class="row" style="gap:24px;align-items:flex-start;">
          <div class="stack" style="flex:1 1 280px;border-top:1px solid var(--gold);padding-top:18px;gap:10px;">
            <h2 style="font-size:24px;font-weight:500;">I can help with</h2>
            <p style="color:var(--ink-2);">{m.helpWith}</p>
          </div>
          <div class="stack" style="flex:1 1 280px;border-top:1px solid var(--gold);padding-top:18px;gap:10px;">
            <h2 style="font-size:24px;font-weight:500;">I'm looking for</h2>
            <p style="color:var(--ink-2);">{m.lookingFor}</p>
          </div>
        </div>
      </div>

      <aside class="stack" style="flex:1 1 300px;min-width:0;gap:20px;">
        <div class="card" style="padding:28px;gap:16px;">
          <p class="eyebrow" style="margin:0;">Connect</p>
          <div><div class="muted">Open to</div><div>{m.openTo.join(', ')}</div></div>
          {m.website && <a href={m.website} style="font-weight:500;">Website</a>}
          {m.linkedin && <a href={m.linkedin} style="font-weight:500;">LinkedIn</a>}
          <p class="muted" style="border-top:1px solid #EDE8DD;padding-top:14px;">Members can reach {m.name.split(' ')[0]} directly in the collective's Slack.</p>
        </div>
        <div class="card dark" style="padding:28px;border:0;">
          <span style="font-family:var(--serif);font-size:22px;">Member since {m.memberSince}</span>
          <p style="font-size:15px;">Every member was referred by another member and reviewed by the collective.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
