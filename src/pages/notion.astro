---
// TEMPORARY: shows the existing Notion page inside the site so www.mindshiftcollective.net
// can point to Netlify before the new home page launches. Delete this page at full launch.
// Paste the public Notion link (Share > Publish > copy link) between the quotes.
const NOTION_URL = '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Mind Shift Collective</title>
  <meta name="description" content="Mind Shift Collective is a referral-based community of practice for the people building the future of mental health and psychedelic medicine." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style>
    html, body { margin: 0; height: 100%; background: #fff; font-family: Inter, system-ui, sans-serif; }
    .frame { position: fixed; inset: 0; width: 100%; height: 100%; border: 0; }
    .fallback { max-width: 480px; margin: 20vh auto; padding: 0 24px; text-align: center; color: #333; line-height: 1.5; }
    .fallback a { color: #8a6d12; }
  </style>
</head>
<body>
  {NOTION_URL ? (
    <>
      <iframe class="frame" src={NOTION_URL} title="Mind Shift Collective" allow="clipboard-write"></iframe>
      <noscript><p class="fallback"><a href={NOTION_URL}>Open the Mind Shift Collective page</a></p></noscript>
    </>
  ) : (
    <div class="fallback">
      <h1 style="font-weight:500;">Mind Shift Collective</h1>
      <p>Our new site is on its way. <a href="/join">Request an invite</a> or write to <a href="mailto:hello@mindshiftcollective.net">hello@mindshiftcollective.net</a>.</p>
    </div>
  )}
</body>
</html>
